# ---------------------------------------------------------------------------
# Crier runs with no credentials at all: the payment gateway and the opening
# prices both fall back to deterministic local adapters, so a fresh clone can be
# played, audited and replayed offline. Fill these in to settle against a real
# PayPal sandbox or to open a session from a live price provider.
# ---------------------------------------------------------------------------

# sim | sandbox   (sim is the default and needs nothing)
GATEWAY=sim

# PayPal sandbox app credentials (Developer Dashboard -> Apps & Credentials -> Sandbox app).
# The app refuses to start in sandbox mode without both, and neither is ever printed or committed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Override only if you are pointed at a different PayPal host.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Webhooks: the id of the webhook registered in the dashboard, plus the public URL it posts to.
# With no id there is nothing to check a signature against, so the route refuses every event it is
# sent with a 401; it answers 501 only while no floor is open, since there is no processor to verify.
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=

# The settlement desk. Unset, every action on a floor is open, which is the right way to run one on
# your own machine. Set it before putting a floor somewhere public: releasing, vetoing, refunding,
# paying out, ringing the bell early and the tamper demonstration then all need the key in an
# x-operator-token header. Shouting at the book stays open either way.
OPERATOR_TOKEN=

# Note attached to seller payouts.
PAYPAL_PAYOUT_BATCH_NOTE=Crier settlement

# Optional live opening prices. Without both values the floor opens from the bundled
# catalogue snapshot, which is what makes a session reproducible.
CATALOG_FEED_URL=
CATALOG_FEED_KEY=

# The seed the terminal tools run a market from - `npm run pit` and `npm run audit:ledger` read this.
# The web door does not: leave its box blank and it mints a fresh seed, type one and you land in that
# pit. The market is a pure function of whichever of the two it is: same seed, same shouts, same hashes.
CRIER_SEED=crier-default-seed

# The interpreter - the voice that reads a held settlement to the person on the pile. Leave all of
# these empty and the desk speaks from a fixed template in src/server/interpreter.ts, which is what a
# fresh clone, the test suite and any public demo run on. Every brief says which of the two wrote it.
#
# 1. A hosted model, if you have one. All three are needed: a base URL and a key without a named model
#    would answer with some default the screen cannot name, so the channel is ignored.
#    Any OpenAI-compatible /chat/completions endpoint works.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
#
# 2. A model on this machine, through Ollama. With no hosted model configured the floor asks a local
#    server what it holds and takes the smallest completion-capable model it finds - so a laptop with
#    `ollama serve` running is an AI product without anybody pasting a key. Name one to choose.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
#
# What a model never does here: it is handed the amounts the engine already decided and asked to talk
# about them. It sets no price, approves nothing, and its words are not sealed into the tape.

# Set to "standalone" to make `next build` emit a self-hosted server bundle.
NEXT_OUTPUT=
