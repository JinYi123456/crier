# ---------------------------------------------------------------------------
# Crier runs with no credentials at all: the payment gateway and the opening
# prices both fall back to deterministic local adapters, so a fresh clone can be
# played, audited and replayed offline. Fill these in to settle against a real
# PayPal sandbox or to open a session from a live price provider.
# ---------------------------------------------------------------------------

# sim | sandbox   (sim is the default and needs nothing)
GATEWAY=sim

# PayPal sandbox app credentials (Developer Dashboard -> Apps & Credentials -> Sandbox app).
# The app refuses to start in sandbox mode without both, and neither is ever printed or committed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Override only if you are pointed at a different PayPal host.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Webhooks: the id of the webhook registered in the dashboard, plus the public URL it posts to.
# Without an id the route answers 501, so nothing outside the app can drive the ledger.
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=

# The settlement desk. Unset, every action on a floor is open, which is the right way to run one on
# your own machine. Set it before putting a floor somewhere public: releasing, vetoing, refunding,
# paying out, ringing the bell early and the tamper demonstration then all need the key in an
# x-operator-token header. Shouting at the book stays open either way.
OPERATOR_TOKEN=

# Note attached to seller payouts.
PAYPAL_PAYOUT_BATCH_NOTE=Crier settlement

# Optional live opening prices. Without both values the floor opens from the bundled
# catalogue snapshot, which is what makes a session reproducible.
CATALOG_FEED_URL=
CATALOG_FEED_KEY=

# The market is a pure function of this seed: same seed, same shouts, same hashes.
CRIER_SEED=crier-default-seed

# Set to "standalone" to make `next build` emit a self-hosted server bundle.
NEXT_OUTPUT=
